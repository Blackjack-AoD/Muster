    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
